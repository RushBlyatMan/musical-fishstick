{
    "name": "Shapeshift",
    "description": "You can shapeshift between a fox and a human form. (Bind this to the same key as Woodwalkers)",
    "type": "origins:multiple",
    "toggle": {
    "type": "origins:toggle",
    "active_by_default": true,
    "key": {
        "key": "key.loadToolbarActivator"
    },
    "retain_state": true
    },
    "shift": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:spawn_particles",
                    "particle": {
                        "type": "minecraft:soul_fire_flame"
                    },
                    "count": 1000,
                    "speed": 0.05,
                    "force": true,
                    "spread": {
                        "x": 0.5,
                        "y": 0.5,
                        "z": 0.5
                    }
                }
            ]
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.loadToolbarActivator",
            "continuous": true
        }
    },
    "tag": {
      "type": "origins:action_on_callback",
      "entity_action_gained": {
    "type": "origins:delay",
    "ticks": 20,
    "action": {
          "type": "origins:execute_command",
          "command": "walkers change2ndShape @s minecraft:fox"
    }
      },
      "entity_action_lost": {
          "type": "origins:execute_command",
          "command": "walkers remove2ndShape @s"
      },
      "execute_chosen_when_orb": true
    }
  
}
