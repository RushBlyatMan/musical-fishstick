{
    "name": "Advanced Shapeshifting",
    "description": "You can shapeshift into any creature you are looking at. (must be sneaking)",
    "type": "origins:multiple",
    "raycast": {
        "type": "origins:active_self",
        "entity_action": {
    "type": "origins:raycast",
    "distance": 50,
    "block": true,
    "entity": true,
    "shape_type": "visual",
    "fluid_handling": "any",
    "command_along_ray_only_on_hit": false,
    "bientity_action": {
        "type": "origins:target_action",
    "action": {
        "type": "origins:execute_command",
        "command": "walkers switchShape @p[tag=kitsuneshift] @s"
    }
}
},
        "cooldown": 20,
        "hud_render": {
            "should_render": false
        },
        "condition": {
    "type": "origins:sneaking"
},
        "key": {
    "key": "key.origins.secondary_active"
}
    },
    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:delay",
    "ticks": 20,
    "action": {
            "type": "origins:execute_command",
            "command": "tag @s add kitsuneshift"
    }
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "tag @s remove kitsuneshift"
        },
        "execute_chosen_when_orb": true
    },
    "shift": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:spawn_particles",
                    "particle": {
                        "type": "minecraft:soul_fire_flame"
                    },
                    "count": 1000,
                    "speed": 0.05,
                    "force": true,
                    "spread": {
                        "x": 0.5,
                        "y": 0.5,
                        "z": 0.5
                    }
                }
            ]
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "condition": {
    "type": "origins:sneaking"
},
        "key": {
            "key": "key.origins.secondary_active",
            "continuous": true
        }
    }
}